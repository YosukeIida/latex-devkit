{
  "lsp": {
    "texlab": {
      "settings": {
        "texlab": {
          "build": {
            "executable": "LATEX_DEVKIT_DIR/bin/latexmk-docker",
            "args": ["%f"],
            "onSave": true,
            "forwardSearchAfter": true,
          },
          "forwardSearch": {
            "executable": "/Applications/Skim.app/Contents/SharedSupport/displayline",
            "args": ["-r", "-z", "-b", "%l", "%p"],
          },
        },
      },
    },
  },
}
